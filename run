#!/usr/bin/env nu

# HomeX dev launcher.
#
# Usage:
#   ./run.nu
#
# Reset dev DB after a model/migration change:
#   rm Downloads/homex.db

$env.HOMEX_TOKEN = "0000"
$env.HOMEX_CONFIG = ($env.PWD | path join "homex.dev.toml")
$env.HOMEX_UNCLASSIFIED_DIR = "/home/eltahawy/Downloads"
$env.DATABASE_URL = "sqlite://Downloads/homex.db"
# $env.SQLX_OFFLINE = "true"

sqlx database create
sqlx migrate run

cargo leptos watch --split --hot-reload

