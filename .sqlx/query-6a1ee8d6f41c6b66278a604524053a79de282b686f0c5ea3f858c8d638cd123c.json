  "db_name": "SQLite",
  "query": "\n        SELECT c.id,\n               c.section_id,\n               s.slug AS section_slug,\n               c.title,\n               c.poster,\n               c.description,\n               COALESCE(\n                   (SELECT COUNT(*) FROM items i WHERE i.collection_id = c.id),\n                   0\n               ) AS \"items_count!\"\n        FROM collections c\n        JOIN sections s ON s.id = c.section_id\n        WHERE s.slug = ? AND c.id = ?\n        ",
