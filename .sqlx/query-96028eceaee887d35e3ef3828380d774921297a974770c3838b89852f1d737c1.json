  "query": "\n        SELECT s.id, s.slug, s.title, s.media_kind, s.nested, s.position,\n               COALESCE(\n                   (SELECT COUNT(*) FROM collections c WHERE c.section_id = s.id),\n                   0\n               ) AS \"collections_count!\"\n        FROM sections s\n        WHERE s.slug = ?\n        ",
